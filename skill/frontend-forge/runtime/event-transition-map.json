        "artifact-store"
      ]
    },
    {
      "event": "ExecutionFailed",
      "from": "EXECUTION_STARTED",
      "to": "EXECUTION_FAILURE",
      "activates": [
        "failure-manager"
      ]
    },
    {
      "event": "QualityValidationStarted",
