      ]
    },
    {
      "event": "AgentConflictDetected",
      "from": "PLAN_VALIDATED",
      "to": "AGENT_CONFLICT",
      "activates": [
        "arbitrator-agent"
      ]
    },
    {
      "event": "AgentConflictDetected",
      "from": "EXECUTION_STARTED",
      "to": "AGENT_CONFLICT",
      "activates": [
        "arbitrator-agent"
      ]
    },
    {
      "event": "AgentConflictDetected",
      "from": "QUALITY_VALIDATION",
      "to": "AGENT_CONFLICT",
      "activates": [
        "arbitrator-agent"
      ]
    },
    {
      "event": "AgentConflictResolved",
      "from": "AGENT_CONFLICT",
