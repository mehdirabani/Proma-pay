{
  "events": [
    {
      "event": "TaskClassified",
      "from": "TASK_RECEIVED",
      "to": "TASK_CLASSIFIED",
      "activates": [
        "requirement-reasoner"
      ]
    },
    {
      "event": "ContextResolved",
      "from": "TASK_CLASSIFIED",
      "to": "CONTEXT_RESOLVED",
      "activates": [
        "context-engine"
      ]
    },
    {
      "event": "ContextFailed",
      "from": "TASK_CLASSIFIED",
      "to": "CONTEXT_FAILURE",
      "activates": [
        "context-engine"
      ]
    },
    {
      "event": "DependenciesAnalyzed",
      "from": "CONTEXT_RESOLVED",
      "to": "DEPENDENCIES_ANALYZED",
      "activates": [
        "impact-analyzer"
      ]
    },
    {
      "event": "DependencyFailed",
      "from": "DEPENDENCIES_ANALYZED",
      "to": "DEPENDENCY_FAILURE",
      "activates": [
        "dependency-resolver"
      ]
    },
    {
      "event": "PlanCreated",
      "from": "DEPENDENCIES_ANALYZED",
      "to": "PLAN_CREATED",
      "activates": [
        "planner"
      ]
    },
    {
      "event": "PlanValidated",
      "from": "PLAN_CREATED",
      "to": "PLAN_VALIDATED",
      "activates": [
        "architecture-agent"
      ]
    },
    {
      "event": "PlanningFailed",
      "from": "PLAN_CREATED",
      "to": "PLANNING_FAILURE",
      "activates": [
        "architecture-agent"
      ]
    },
    {
      "event": "AgentConflictDetected",
      "from": "PLAN_CREATED",
      "to": "AGENT_CONFLICT",
