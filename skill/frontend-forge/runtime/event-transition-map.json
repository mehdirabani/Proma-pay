      ]
    },
    {
      "event": "RepairStarted",
      "from": "TEST_FAILURE",
      "to": "REPAIR",
      "activates": [
        "failure-manager",
        "frontend-agent"
      ]
    },
    {
      "event": "RepairStarted",
      "from": "QUALITY_GATE_FAILURE",
      "to": "REPAIR",
      "activates": [
        "failure-manager",
        "frontend-agent"
      ]
    },
    {
      "event": "RepairStarted",
      "from": "REGRESSION_DETECTED",
      "to": "REPAIR",
      "activates": [
        "failure-manager",
        "frontend-agent"
      ]
    },
    {
      "event": "AbortRequested",
      "from": "EXECUTION_FAILURE",
      "to": "ABORT_REQUESTED",
      "activates": [
        "failure-manager"
      ]
    },
    {
      "event": "AbortRequested",
      "from": "TEST_FAILURE",
      "to": "ABORT_REQUESTED",
      "activates": [
        "failure-manager"
      ]
    },
    {
      "event": "AbortRequested",
      "from": "QUALITY_GATE_FAILURE",
      "to": "ABORT_REQUESTED",
      "activates": [
        "failure-manager"
      ]
    },
    {
      "event": "AbortRequested",
      "from": "REGRESSION_DETECTED",
      "to": "ABORT_REQUESTED",
      "activates": [
        "failure-manager"
      ]
    },
    {
      "event": "AbortRequested",
      "from": "CONTEXT_FAILURE",
      "to": "ABORT_REQUESTED",
      "activates": [
        "failure-manager"
      ]
    },
    {
      "event": "AbortRequested",
      "from": "PLANNING_FAILURE",
      "to": "ABORT_REQUESTED",
      "activates": [
        "failure-manager"
      ]
    },
    {
      "event": "AbortRequested",
      "from": "DEPENDENCY_FAILURE",
      "to": "ABORT_REQUESTED",
      "activates": [
        "failure-manager"
      ]
    },
    {
      "event": "AbortRequested",
      "from": "AGENT_CONFLICT",
      "to": "ABORT_REQUESTED",
      "activates": [
        "failure-manager"
      ]
    },
    {
      "event": "RepairCompleted",
      "from": "REPAIR",
      "to": "REVALIDATE",
      "activates": [
        "qa-agent"
      ]
    },
    {
      "event": "RevalidationCompleted",
      "from": "REVALIDATE",
      "to": "QUALITY_VALIDATION",
      "activates": [
        "quality-engine"
      ]
    },
    {
      "event": "RevalidationTestFailed",
      "from": "REVALIDATE",
      "to": "TEST_FAILURE",
      "activates": [
        "qa-agent"
      ]
    },
    {
      "event": "KnowledgeUpdated",
      "from": "KNOWLEDGE_UPDATE",
      "to": "TASK_COMPLETED",
      "activates": [
        "observability"
      ]
    },
    {
      "event": "CancelRequested",
      "from": "EXECUTION_STARTED",
      "to": "CANCEL_REQUESTED",
      "activates": [
        "failure-manager"
      ]
    },
    {
      "event": "CancelRequested",
      "from": "OUTPUT_GENERATED",
      "to": "CANCEL_REQUESTED",
      "activates": [
        "failure-manager"
      ]
    },
    {
      "event": "CancelRequested",
      "from": "QUALITY_VALIDATION",
      "to": "CANCEL_REQUESTED",
      "activates": [
        "failure-manager"
      ]
    },
    {
      "event": "SafeStop",
      "from": "ABORT_REQUESTED",
      "to": "SAFE_STOP",
      "activates": [
        "artifact-store"
      ]
    },
    {
      "event": "SafeStop",
      "from": "CANCEL_REQUESTED",
      "to": "SAFE_STOP",
      "activates": [
        "artifact-store"
      ]
    },
    {
      "event": "AbortFinalized",
      "from": "SAFE_STOP",
      "to": "TASK_ABORTED",
      "activates": [
        "observability"
      ]
    },
    {
      "event": "CancelFinalized",
      "from": "SAFE_STOP",
      "to": "TASK_CANCELLED",
      "activates": [
        "observability"
      ]
    }
  ]
}
