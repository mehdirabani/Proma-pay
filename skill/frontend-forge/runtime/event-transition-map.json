    {
      "event": "ApprovalDenied",
      "from": "AWAITING_APPROVAL",
      "to": "ABORT_REQUESTED",
      "activates": [
        "failure-manager"
      ]
    },
    {
      "event": "ExecutionStarted",
      "from": "PLAN_VALIDATED",
      "to": "EXECUTION_STARTED",
      "activates": [
        "capability-executor"
      ]
    },
    {
      "event": "OutputGenerated",
      "from": "EXECUTION_STARTED",
      "to": "OUTPUT_GENERATED",
