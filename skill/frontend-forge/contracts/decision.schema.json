{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "decision",
    "alternatives",
    "benefits",
    "costs",
    "risks",
    "confidence"
  ],
  "properties": {
    "decision": {
      "type": "string"
    },
    "alternatives": {
      "type": "array"
    },
    "benefits": {
      "type": "array"
    },
    "costs": {
      "type": "array"
    },
    "risks": {
      "type": "array"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}