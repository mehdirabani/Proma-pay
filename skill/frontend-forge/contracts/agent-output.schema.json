{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "artifacts",
    "summary"
  ],
  "properties": {
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL"
      ]
    },
    "artifacts": {
      "type": "array"
    },
    "summary": {
      "type": "string"
    }
  }
}
