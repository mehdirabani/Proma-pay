{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "evidence_id",
    "metric",
    "score",
    "source",
    "tool_version",
    "timestamp",
    "artifact",
    "hash"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "metric": {
      "type": "string"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "source": {
      "type": "string"
    },
    "tool_version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "artifact": {
      "type": "string"
    },
    "hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64
    }
  }
}
