{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "task",
    "category",
    "concept_group",
    "split",
    "expected"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "task": {
      "type": "string",
      "minLength": 4
    },
    "category": {
      "type": "string"
    },
    "concept_group": {
      "type": "string"
    },
    "split": {
      "enum": [
        "development",
        "validation",
        "hidden"
      ]
    },
    "expected": {
      "type": "object"
    }
  }
}