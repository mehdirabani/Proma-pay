Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Internal records and update archives are never public download targets.
    RewriteRule ^storage/(?:logs|backups|updates|releases)/ - [F,L,NC]

    # Health endpoints bypass the generic rewrite so uptime monitors can call
    # /health/live and /health/ready without an application-specific query string.
    RewriteRule ^health/(live|ready)/?$ index.php?route=health/$1 [L,QSA,NC]

    # HTTPS redirect is intentionally not forced here. Some shared hosts and
    # reverse proxies terminate SSL before PHP; forcing HTTPS in app code can
    # create redirect loops. Enable HTTPS from the hosting panel/CDN instead.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

ErrorDocument 400 /static-errors/400.html
ErrorDocument 403 /static-errors/403.html
ErrorDocument 404 /static-errors/404.html
ErrorDocument 429 /static-errors/429.html
ErrorDocument 500 /static-errors/500.html
ErrorDocument 502 /static-errors/502.html
ErrorDocument 503 /static-errors/503.html
ErrorDocument 504 /static-errors/504.html

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "^(installed\.lock|\.env|composer\.(json|lock)|package(-lock)?\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^(service-worker\.js|reset-service-worker\.html)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>
