    {
      "key": "plugin.proma-repair.view_orders",
      "label": "مشاهده تعمیرات"
    },
    {
      "key": "plugin.proma-repair.create_orders",
      "label": "ثبت تعمیر جدید"
    },
    {
      "key": "plugin.proma-repair.manage_orders",
      "label": "ویرایش تعمیرات"
    },
    {
      "key": "plugin.proma-repair.change_status",
      "label": "تغییر وضعیت تعمیر"
    },
    {
      "key": "plugin.proma-repair.assign_technicians",
      "label": "ارجاع تعمیرکار"
    },
    {
      "key": "plugin.proma-repair.manage_technicians",
      "label": "مدیریت تعمیرکاران"
    },
    {
      "key": "plugin.proma-repair.view_financial",
      "label": "مشاهده اطلاعات مالی تعمیرات"
